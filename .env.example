# ============================================================
# Una — Variáveis de Ambiente
#
# Copie este arquivo para .env.local (frontend) ou .env e
# preencha os valores conforme o ambiente.
#
# NUNCA commitar arquivos .env ou .env.local com valores reais.
# ============================================================


# ------------------------------------------------------------
# SUPABASE — Banco de dados e autenticação em produção
# Encontre em: Supabase Dashboard → Settings → API
# ------------------------------------------------------------

# URL pública do projeto Supabase (usada no frontend/cliente)
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co

# Chave anônima (pública) — segura para expor no cliente
# Usada pelo Next.js frontend e pelo app React Native
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Chave de Service Role (SECRETA) — NUNCA expor no cliente
# Usada apenas no servidor (NestJS backend ou Server Actions do Next.js)
# Encontre em: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>


# ------------------------------------------------------------
# BANCO DE DADOS LOCAL (Docker) — apenas para desenvolvimento
# Usado quando você roda `docker compose up` localmente.
# Não necessário se usar o Supabase hosted diretamente.
# ------------------------------------------------------------

# URL de conexão direta ao PostgreSQL local (Docker)
# Formato: postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/una_dev

# Senha do PostgreSQL local (default: postgres)
DB_PASSWORD=postgres

# Porta do PostgreSQL local (default: 5432)
DB_PORT=5432

# Setar como 'true' para popular o banco com dados de teste (campus UFPE)
# ao subir o container pela primeira vez
SEED_DB=false


# ------------------------------------------------------------
# REDIS — Cache em memória (opcional para MVP)
# Ativar com: docker compose --profile cache up
# ------------------------------------------------------------

# URL do Redis (local via Docker ou Upstash para produção)
REDIS_URL=redis://localhost:6379

# Porta do Redis local (default: 6379)
REDIS_PORT=6379


# ------------------------------------------------------------
# NEXT.JS — Configurações do painel admin
# ------------------------------------------------------------

# URL base do painel web (usada em redirects e emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ambiente: development | staging | production
NODE_ENV=development
